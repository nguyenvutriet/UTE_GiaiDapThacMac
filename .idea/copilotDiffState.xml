    &lt;a class=&quot;tab-item&quot; th:classappend=&quot;${activeTab == 'all'} ? ' active'&quot;&#10;               th:href=&quot;@{/admin/notifications(tab='all',filter=${activeFilter})}&quot;&gt;Tat ca &lt;span th:text=&quot;${countAll}&quot;&gt;0&lt;/span&gt;&lt;/a&gt;&#10;            &lt;a class=&quot;tab-item&quot; th:classappend=&quot;${activeTab == 'feedback'} ? ' active'&quot;&#10;               th:href=&quot;@{/admin/notifications(tab='feedback',filter=${activeFilter})}&quot;&gt;Gop y &lt;span th:text=&quot;${countFeedback}&quot;&gt;0&lt;/span&gt;&lt;/a&gt;&#10;            &lt;a class=&quot;tab-item&quot; th:classappend=&quot;${activeTab == 'forum'} ? ' active'&quot;&#10;               th:href=&quot;@{/admin/notifications(tab='forum',filter=${activeFilter})}&quot;&gt;Dien dan &lt;span th:text=&quot;${countForum}&quot;&gt;0&lt;/span&gt;&lt;/a&gt;&#10;        &lt;/div&gt;&#10;&#10;        &lt;section class=&quot;notification-list&quot; th:if=&quot;${not #lists.isEmpty(notifications)}&quot;&gt;&#10;            &lt;article class=&quot;notification-item&quot;&#10;                     th:classappend=&quot;${item.read} ? ' read' : ' unread'&quot;&#10;                     th:attr=&quot;data-read-form-id='read-notification-' + ${item.id}&quot;&#10;                     th:each=&quot;item : ${notifications}&quot;&gt;&#10;                &lt;div class=&quot;item-icon&quot; th:classappend=&quot;${' ' + item.iconClass}&quot; th:text=&quot;${item.icon}&quot;&gt;!&lt;/div&gt;&#10;                &lt;div class=&quot;item-content&quot;&gt;&#10;                    &lt;div class=&quot;item-head&quot;&gt;&#10;                        &lt;h3 th:text=&quot;${item.title}&quot;&gt;Thong bao&lt;/h3&gt;&#10;                        &lt;div class=&quot;item-actions&quot;&gt;&#10;                            &lt;span th:text=&quot;${item.timeLabel}&quot;&gt;hom nay&lt;/span&gt;&#10;                            &lt;form method=&quot;post&quot; th:action=&quot;@{/admin/notifications/delete}